FLASK_ENV=production
FLASK_RUN_PORT=8080
FLASK_RUN_HOST=localhost
DEBUG=False
# Generate your own value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-new-random-value
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_SERVER=127.0.0.1
DB_PORT=27017
IMAGE_FOLDER="app/static/images"
UPLOADS_FOLDER="app/static/uploads"
BASE_URL="/"
